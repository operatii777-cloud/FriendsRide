rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return request.auth.uid == userId;
    }
    
    function isEmailVerified() {
      return request.auth.token.email_verified == true;
    }
    
    function isRideParticipant(rideId) {
      return isAuthenticated() && 
        (request.auth.uid == resource.data.passengerId || 
         request.auth.uid == resource.data.driverId);
    }
    
    function isEmergencyParticipant(emergencyId) {
      return isAuthenticated() && 
        (request.auth.uid == resource.data.reporterId || 
         request.auth.uid == resource.data.responderId);
    }
    
    function isDeliveryParticipant(orderId) {
      return isAuthenticated() && 
        (request.auth.uid == resource.data.customerId || 
         request.auth.uid == resource.data.courierId ||
         request.auth.uid == resource.data.restaurantOwnerId);
    }
    
    function isRestaurantOwner(restaurantId) {
      return isAuthenticated() && 
        request.auth.uid == resource.data.ownerId;
    }
    
    function isCourier(courierId) {
      return isAuthenticated() && 
        request.auth.uid == courierId;
    }
    
    // ✅ ENHANCED: Users collection with better security
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && isOwner(userId);
      allow update: if isAuthenticated() && isOwner(userId);
      // Prevent users from deleting their own profile
      allow delete: if false;
      
      // ✅ NOU: Payment methods subcollection pentru Wallet
      match /payment_methods/{methodId} {
        allow read, write, delete: if isAuthenticated() && isOwner(userId);
      }
      
      // ✅ NOU: Vouchers subcollection pentru Wallet
      match /vouchers/{voucherId} {
        allow read, write, delete: if isAuthenticated() && isOwner(userId);
      }
      
      // ✅ ENHANCED: Saved addresses (deja există, dar o menționăm pentru claritate)
      match /saved_addresses/{addressId} {
        allow read, write, delete: if isAuthenticated() && isOwner(userId);
      }
    }
    
    // ✅ CRITICAL FIX: Ride requests with PERMISSIVE update for driver acceptance
    match /ride_requests/{rideId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      // ✅ PERMISIV: Orice user autentificat poate actualiza (necesar pentru acceptarea cursei)
      allow update: if isAuthenticated();
      // Only allow deletion by ride owner or admin
      allow delete: if isAuthenticated() && isOwner(resource.data.passengerId);
      
      // ✅ ENHANCED: Chat subcollection
      match /chat/{messageId} {
        allow read: if isAuthenticated();
        allow create: if isAuthenticated();
        // Only allow editing own messages
        allow update: if isAuthenticated() && isOwner(resource.data.senderId);
        // Only allow deleting own messages
        allow delete: if isAuthenticated() && isOwner(resource.data.senderId);
      }
    }
    
    // ✅ ENHANCED: Driver locations with stricter controls
    match /driver_locations/{driverId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated() && isOwner(driverId);
      allow delete: if isAuthenticated() && isOwner(driverId);
    }
    
    // ✅ ENHANCED: Drivers collection
    match /drivers/{driverId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated() && isOwner(driverId);
      allow delete: if false; // Prevent driver profile deletion
    }
    
    // ✅ ENHANCED: Driver applications
    match /driver_applications/{userId} {
      allow read: if isAuthenticated() && isOwner(userId);
      allow create: if isAuthenticated() && isOwner(userId);
      allow update: if isAuthenticated() && isOwner(userId);
      allow delete: if false; // Keep application history
    }
    
    // ✅ ENHANCED: Payment methods with ownership (colecție de nivel superior - pentru backward compatibility)
    match /payment_methods/{methodId} {
      allow read: if isAuthenticated() && isOwner(resource.data.userId);
      allow write: if isAuthenticated() && isOwner(resource.data.userId);
      allow delete: if isAuthenticated() && isOwner(resource.data.userId);
    }
    
    // ✅ ENHANCED: Vouchers with usage tracking (colecție de nivel superior - pentru backward compatibility)
    match /vouchers/{voucherId} {
      allow read: if isAuthenticated();
      allow create: if false; // Only created by admin/backend
      allow update: if isAuthenticated(); // For usage tracking
      allow delete: if false; // Keep voucher history
    }
    
    // ✅ NOU: Business profile requests pentru Wallet
    match /business_profile_requests/{requestId} {
      allow read: if isAuthenticated() && isOwner(resource.data.userId);
      allow create: if isAuthenticated();
      allow update: if isAuthenticated() && isOwner(resource.data.userId);
      allow delete: if false; // Keep request history
    }
    
    // ✅ NOU: Referral codes pentru Wallet
    match /referral_codes/{codeId} {
      allow read: if isAuthenticated();
      allow create: if false; // Only created by admin/backend
      allow update: if isAuthenticated(); // For usage tracking
      allow delete: if false; // Keep referral history
    }
    
    // ✅ ENHANCED: Support tickets
    match /support_tickets/{ticketId} {
      allow read: if isAuthenticated() && isOwner(resource.data.userId);
      allow create: if isAuthenticated();
      allow update: if isAuthenticated() && isOwner(resource.data.userId);
      allow delete: if false; // Keep support history
    }
    
    // ✅ ENHANCED: Ride history with better access control
    match /ride_history/{rideId} {
      allow read: if isAuthenticated() && 
        (isOwner(resource.data.passengerId) || isOwner(resource.data.driverId));
      allow create: if isAuthenticated();
      allow update: if false; // History should be immutable
      allow delete: if false; // Keep history for legal/business purposes
    }
    
    // ✅ ENHANCED: Chat messages with ownership
    match /chat_messages/{messageId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update: if isAuthenticated() && isOwner(resource.data.senderId);
      allow delete: if isAuthenticated() && isOwner(resource.data.senderId);
    }
    
    // ✅ NEW: App configuration (read-only for clients)
    match /app_config/{configId} {
      allow read: if isAuthenticated();
      allow write: if false; // Only backend can update
    }
    
    // ✅ NEW: Notifications
    match /notifications/{notificationId} {
      allow read: if isAuthenticated() && isOwner(resource.data.userId);
      allow create: if false; // Only backend creates notifications
      allow update: if isAuthenticated() && isOwner(resource.data.userId); // Mark as read
      allow delete: if isAuthenticated() && isOwner(resource.data.userId);
    }
    
    // 🆕 NEW: Real-time Tracking System
    match /real_time_tracking/{trackingId} {
      allow read: if isAuthenticated() && isRideParticipant(resource.data.rideId);
      allow create: if isAuthenticated();
      allow update: if isAuthenticated() && 
        (isOwner(resource.data.userId) || isRideParticipant(resource.data.rideId));
      allow delete: if false; // Keep tracking history
    }
    
    // 🆕 NEW: Live Location Updates
    match /live_locations/{locationId} {
      allow read: if isAuthenticated() && isRideParticipant(resource.data.rideId);
      allow create: if isAuthenticated() && isOwner(resource.data.userId);
      allow update: if isAuthenticated() && isOwner(resource.data.userId);
      allow delete: if false; // Keep location history
    }
    
    // 🆕 NEW: AI Predictions Storage
    match /ai_predictions/{predictionId} {
      allow read: if isAuthenticated() && isRideParticipant(resource.data.rideId);
      allow create: if isAuthenticated();
      allow update: if isAuthenticated() && isOwner(resource.data.userId);
      allow delete: if false; // Keep prediction history
    }
    
    // 🆕 NEW: Emergency Alerts System
    match /emergency_alerts/{alertId} {
      allow read: if isAuthenticated() && 
        (isOwner(resource.data.reporterId) || 
         isEmergencyParticipant(alertId) ||
         request.auth.uid == resource.data.responderId);
      allow create: if isAuthenticated();
      allow update: if isAuthenticated() && 
        (isOwner(resource.data.reporterId) || 
         request.auth.uid == resource.data.responderId);
      allow delete: if false; // Keep emergency history
    }
    
    // 🆕 NEW: Emergency Response Logs
    match /emergency_responses/{responseId} {
      allow read: if isAuthenticated() && 
        (isOwner(resource.data.responderId) || 
         isOwner(resource.data.reporterId));
      allow create: if isAuthenticated();
      allow update: if isAuthenticated() && isOwner(resource.data.responderId);
      allow delete: if false; // Keep response history
    }
    
    // 🆕 NEW: Real-time Communication Logs
    match /real_time_communications/{communicationId} {
      allow read: if isAuthenticated() && isRideParticipant(resource.data.rideId);
      allow create: if isAuthenticated();
      allow update: if isAuthenticated() && isOwner(resource.data.senderId);
      allow delete: if isAuthenticated() && isOwner(resource.data.senderId);
    }
    
    // 🆕 NEW: Performance Monitoring Data
    match /performance_metrics/{metricId} {
      allow read: if isAuthenticated() && isOwner(resource.data.userId);
      allow create: if isAuthenticated();
      allow update: if isAuthenticated() && isOwner(resource.data.userId);
      allow delete: if false; // Keep performance history
    }
    
    // 🆕 NEW: System Health Monitoring
    match /system_health/{healthId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update: if false; // Only backend can update system health
      allow delete: if false; // Keep health monitoring data
    }
    
    // 🚚 DELIVERY: Restaurants collection
    match /restaurants/{restaurantId} {
      allow read: if isAuthenticated(); // All authenticated users can read restaurants
      allow create: if false; // Only backend/admin can create restaurants
      allow update: if isAuthenticated() && isRestaurantOwner(restaurantId);
      allow delete: if false; // Keep restaurant history
      
      // Products subcollection
      match /products/{productId} {
        allow read: if isAuthenticated();
        allow create: if isAuthenticated() && isRestaurantOwner(restaurantId);
        allow update: if isAuthenticated() && isRestaurantOwner(restaurantId);
        allow delete: if isAuthenticated() && isRestaurantOwner(restaurantId);
      }
    }
    
    // 🚚 DELIVERY: Delivery orders collection
    match /delivery_orders/{orderId} {
      allow read: if isAuthenticated() && isDeliveryParticipant(orderId);
      allow create: if isAuthenticated(); // Customers can create orders
      allow update: if isAuthenticated() && 
        (isOwner(resource.data.customerId) || 
         isCourier(resource.data.courierId) ||
         isRestaurantOwner(resource.data.restaurantId));
      allow delete: if false; // Keep order history
      
      // Order items subcollection
      match /items/{itemId} {
        allow read: if isAuthenticated() && isDeliveryParticipant(orderId);
        allow create: if isAuthenticated();
        allow update: if isAuthenticated() && isDeliveryParticipant(orderId);
        allow delete: if false; // Keep item history
      }
      
      // Status updates subcollection
      match /status_updates/{updateId} {
        allow read: if isAuthenticated() && isDeliveryParticipant(orderId);
        allow create: if isAuthenticated();
        allow update: if false; // Status updates are immutable
        allow delete: if false; // Keep status history
      }
    }
    
    // 🚚 DELIVERY: Couriers collection
    match /couriers/{courierId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && isCourier(courierId);
      allow update: if isAuthenticated() && isCourier(courierId);
      allow delete: if false; // Keep courier history
      
      // Courier location updates
      match /location_updates/{updateId} {
        allow read: if isAuthenticated();
        allow create: if isAuthenticated() && isCourier(courierId);
        allow update: if isAuthenticated() && isCourier(courierId);
        allow delete: if false; // Keep location history
      }
    }
    
    // 🚚 DELIVERY: Restaurant couriers (managed by restaurants)
    match /restaurant_couriers/{courierId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && isRestaurantOwner(resource.data.restaurantId);
      allow update: if isAuthenticated() && 
        (isCourier(courierId) || isRestaurantOwner(resource.data.restaurantId));
      allow delete: if isAuthenticated() && isRestaurantOwner(resource.data.restaurantId);
    }
    
    // 🚚 DELIVERY: API keys for restaurants
    match /restaurant_api_keys/{keyId} {
      allow read: if false; // API keys should never be readable by clients
      allow create: if false; // Only backend creates API keys
      allow update: if false; // Only backend updates API keys
      allow delete: if false; // Keep key history
    }
    
    // 🚚 DELIVERY: Restaurant onboarding requests
    match /restaurant_onboarding/{requestId} {
      allow read: if isAuthenticated() && isOwner(resource.data.restaurantOwnerId);
      allow create: if isAuthenticated();
      allow update: if isAuthenticated() && isOwner(resource.data.restaurantOwnerId);
      allow delete: if false; // Keep onboarding history
    }
    
    // Default deny all other documents
    match /{document=**} {
      allow read, write: if false;
    }
  }
}

