{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Flutter: Rulează Testele",
      "type": "shell",
      "command": "flutter test",
      "group": {
        "kind": "test",
        "isDefault": true
      },
      "presentation": {
        "reveal": "always",
        "panel": "new",
        "clear": true
      },
      "problemMatcher": []
    },
    {
      "label": "Flutter: Analizează Codul",
      "type": "shell",
      "command": "flutter analyze",
      "group": "build",
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      },
      "problemMatcher": []
    },
    {
      "label": "Flutter: Ia Pachetele (Pub Get)",
      "type": "shell",
      "command": "flutter pub get",
      "presentation": {
        "reveal": "always",
        "clear": true
      },
      "problemMatcher": []
    },
    {
      "label": "Flutter: Curăță Proiectul (Clean)",
      "type": "shell",
      "command": "flutter clean",
      "presentation": {
        "reveal": "always",
        "clear": true
      },
      "problemMatcher": []
    },
    {
      "label": "Flutter: Rulează Aplicația (Debug)",
      "type": "shell",
      "command": "flutter run",
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "presentation": {
        "reveal": "always",
        "clear": true
      },
      "problemMatcher": []
    },
    {
      "label": "Flutter: Construiește APK (Release)",
      "type": "shell",
      "command": "flutter build apk --release",
      "group": "build",
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      },
      "problemMatcher": []
    },
    {
      "label": "Flutter: Teste cu Reporter Compact",
      "type": "shell",
      "command": "flutter test --reporter=compact",
      "group": "test",
      "presentation": {
        "reveal": "always",
        "panel": "new",
        "clear": true
      },
      "problemMatcher": []
    },
    {
      "label": "Flutter: Teste cu Coverage",
      "type": "shell",
      "command": "flutter test --coverage",
      "group": "test",
      "presentation": {
        "reveal": "always",
        "panel": "new",
        "clear": true
      },
      "problemMatcher": []
    }
  ]
}
